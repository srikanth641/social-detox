# PostgreSQL Connection String (e.g. postgresql://postgres:password@localhost:5432/social_detox)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_detox

# MongoDB Connection String (e.g. mongodb://localhost:27017/social_detox or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/social_detox

# AI Assistant Configuration (Gemini or OpenAI API compatible)
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-flash

# Backend Server Port & Environment
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Authentication & Session Secrets
SESSION_SECRET=super_secret_session_key_replace_in_production
JWT_SECRET=super_secret_jwt_key_replace_in_production

# Logging Configuration (debug, info, warn, error)
LOG_LEVEL=info

# Third-Party Motivation API (ZenQuotes / Quotable / AdviceSlip)
MOTIVATION_API_URL=https://zenquotes.io/api/today
